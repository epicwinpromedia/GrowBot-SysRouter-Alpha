# GrowBot keys — the one list for every component that reads a key from a file (R-SEC-1).
#
# HOW TO USE:  copy this file to `.env` (same folder), fill in what you need, leave the rest.
#              `.env` is ignored by git (.gitignore). Never commit it, never paste a key in chat.
#
# WHO CAN READ `.env`:  only tools you run on your own computer (the harness, the benchmarks,
#   the local proxy). The app page at growbot.dev can NOT read files on your computer. To use
#   your keys with the live app without putting them in the browser, run the local proxy
#   (sysrouter/tools/proxy.mjs) and give the app the proxy's address.
#
# Each line says: what reads it, and the ONE host the value is ever sent to.

# --- one key that reaches every model (decision engines and chat models) ---
# read by: sysrouter/bench/*, sysrouter/tools/proxy.mjs
# sent to: openrouter.ai   (must start with sk-or-)
OPENROUTER_API_KEY=

# --- optional: TypeSafe direct (Jev only), instead of going through OpenRouter ---
# read by: sysrouter/bench/*, sysrouter/tools/proxy.mjs      sent to: api.typesafe.ai
TYPESAFE_API_KEY=

# --- optional: your own server or proxy in place of every key above ---
# read by: sysrouter/bench/*      sent to: the host in SYSROUTER_URL (https, or http://localhost)
# SYSROUTER_KEY is a shared word YOU choose; the proxy then refuses requests without it.
SYSROUTER_URL=
SYSROUTER_KEY=

# --- the local proxy (sysrouter/tools/proxy.mjs) ---
SYSROUTER_PROXY_PORT=8787
# page origins allowed to use the proxy, comma separated
SYSROUTER_ALLOW_ORIGIN=https://growbot.dev,http://localhost:8765
# SHADOW=1 also asks the System One routes about each line the brain is asked, and logs
# what they decided (a hash of the words only) to sysrouter/results/shadow.jsonl
SHADOW=
SHADOW_MODEL=cloudflare/clef-flash

# --- the agent harness (agent-harness/reference-loop.mjs) reads these from the environment today ---
# They are listed here so there is one place to look. sent to: the host in BASE_URL
BASE_URL=
MODEL=

# NOT here, on purpose:
#   firmware Wi-Fi settings  -> firmware/secrets.example.py (copy to secrets.py on the chip)
#   keys typed into the app  -> stay in that browser's localStorage (pb_byok, pb_llm_key)
